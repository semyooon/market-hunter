# Keep this secret outside Git. Generate one with: openssl rand -hex 32
MARKET_HUNTER_API_TOKEN=replace-me-before-exposing-the-api
MARKET_HUNTER_DATABASE_PATH=data/market-hunter.db
MARKET_HUNTER_REQUEST_TIMEOUT_SECONDS=20
MARKET_HUNTER_MAX_RESULTS_PER_SOURCE=30
MARKET_HUNTER_USER_AGENT="MarketHunter/0.1 (personal deal monitor; contact: you@example.com)"
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_DE

# The local MCP bridge uses this URL. On the VPS, keep the API on a private VPN address.
MARKET_HUNTER_API_URL=http://127.0.0.1:8000
